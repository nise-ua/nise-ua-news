PORT=3000
API_SECRET_KEY=change-me-to-a-strong-random-key
DASHBOARD_USER=admin

# LLM Configuration (OpenAI default)
LLM_VENDOR=openai
CLAUDE_MODEL=gpt-5.4-mini            # Model ID from model-catalog.js (or custom like gpt-4o)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=

# (Optional) Anthropic backup
# ANTHROPIC_API_KEY=sk-ant-...

DB_PATH=./data/news-digest.db
NTFY_TOPIC=news-digest
ARTICLE_THRESHOLD=13
MAX_ARTICLES_PER_DIGEST=17
CHECK_INTERVAL_MS=60000
NODE_ENV=development

# Facebook Page (Primary Publisher)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Telegram (Unused, leave blank for FB-only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# YouTube (Unused, leave blank for FB-only)
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CHANNEL_ID=

# Domain
BASE_URL=http://localhost:3000

