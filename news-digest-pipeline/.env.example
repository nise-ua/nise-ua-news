PORT=3000
API_SECRET_KEY=change-me-to-a-strong-random-key
DASHBOARD_USER=admin

# LLM Configuration (OpenAI default)
# Vendors: openai | anthropic | openrouter | moonshot
LLM_VENDOR=openai
CLAUDE_MODEL=gpt-5.4-mini            # Model ID from model-catalog.js (or custom like gpt-4o)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=

# (Optional) Anthropic backup
# ANTHROPIC_API_KEY=sk-ant-...

# (Optional) OpenRouter — for DeepSeek & routed models
# Set LLM_VENDOR=openrouter and CLAUDE_MODEL=deepseek/deepseek-chat (or deepseek/deepseek-reasoner)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=

# (Optional) Moonshot — for Kimi models
# Set LLM_VENDOR=moonshot and CLAUDE_MODEL=kimi-k2.6 (or kimi-k1.5, kimi-latest)
MOONSHOT_API_KEY=your-moonshot-api-key-here
MOONSHOT_BASE_URL=

# Image generation (used by Instagram and V1 Reel pipelines)
IMAGE_VENDOR=openrouter
DALLE_MODEL=qwen/qwen-image-3-pro

# Reel frame mode for dashboard Video / Shorts buttons:
#   ai   — production/video/src/generate-reel.js (AI bg + SVG overlay)
#   html — production/html-reel (AI scene + HTML text hybrid)
REEL_FRAME_MODE=ai

# Direct-video V2 (Phase 1 adapter; V1 remains the default production path)
VIDEO_PIPELINE_VERSION=v1
VEO_MODEL=x-ai/grok-imagine-video-1.5
VEO_RESOLUTION=720p
VEO_DURATION=8
VEO_GENERATE_AUDIO=true

DB_PATH=./data/news-digest.db
NTFY_TOPIC=news-digest
ARTICLE_THRESHOLD=13
MAX_ARTICLES_PER_DIGEST=17
CHECK_INTERVAL_MS=60000
NODE_ENV=development

# Facebook Page (Primary Publisher)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_NAME=
# Optional Patchright profile for Page composer posts (default: .fb-page-profile)
# FACEBOOK_BROWSER_PROFILE_DIR=
# FACEBOOK_BROWSER_TIMEZONE=America/New_York

# Facebook App Credentials (for token refresh)
# Get from developers.facebook.com → App Settings → Basic
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Telegram (Unused, leave blank for FB-only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# YouTube (Unused, leave blank for FB-only)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
YOUTUBE_PRIVACY_STATUS=unlisted

# Domain
BASE_URL=http://localhost:3000

